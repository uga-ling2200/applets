                "answers": [
                  {
                    "text": "<code>r\"&lt;.*&gt;\"</code>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "On this text, the greedy quantifier extends the match through &lt;blue&gt;. That includes more than the first bracketed piece.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<code>r\"&lt;.*?&gt;\"</code>",
                    "correct": true,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "For this text, the lazy quantifier lets the match finish at the &gt; after red, giving &lt;red&gt;.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<code>r\".*?\"</code>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "This pattern has no required brackets. Since *? allows zero repetitions, its first match is an empty string.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<code>r\"&lt;.*\"</code>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "This pattern does not require a closing &gt;. Its greedy quantifier continues to the end of this text.",
                      "notChosenFeedback": ""
                    }
                  }
