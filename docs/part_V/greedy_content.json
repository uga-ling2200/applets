                    "text": "None",
                    "correct": true,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "The pattern requires a closing &gt;, but the text has none. A lazy quantifier does not remove that requirement.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "A Match object containing &lt;red",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "The required closing &gt; is missing. A partial match of the pattern is not enough.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "A Match object containing an empty string",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "Although .*? allows zero repetitions, the complete pattern still requires both &lt; and &gt;.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "An empty list []",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "search() returns None when no match exists. An empty list is the no-match result of findall().",
                      "notChosenFeedback": ""
                    }
                  }
