                  "disableImageZooming": false
                },
                "answers": [
                  {
                    "text": "<code>&lt;red&gt; and &lt;blue&gt;</code>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "That is the greedy result. With .*?, the pattern can finish at the first &gt;, so it does not need to extend farther.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<code>red</code>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "group() returns the complete match. The literal &lt; and &gt; are part of this pattern, so they are included.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<code>&lt;red&gt;</code>",
                    "correct": true,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "Lazy .*? tries fewer repetitions first. Starting at the first &lt;, the earliest successful ending for this complete pattern is the &gt; after red.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<code>[\"&lt;red&gt;\", \"&lt;blue&gt;\"]</code>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "This is a list of two matches. search() and group() return the text of the first match, not a list of all matches.",
                      "notChosenFeedback": ""
                    }
                  }
                ],
