              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><code>def remember(word, words_to_include=set()):<br />\u00a0\u00a0\u00a0\u00a0words_to_include.add(word)<br />\u00a0\u00a0\u00a0\u00a0return words_to_include</code></p>"
