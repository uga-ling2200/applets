                    "text": "Yes. Calling any function automatically adds its input words to the default set.",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "Calling a function does not change a set unless the executed operations mutate it.",
                      "notChosenFeedback": ""
