              "library": "H5P.MultiChoice 1.16",
              "params": {
                "media": {
                  "disableImageZooming": false
                },
                "answers": [
                  {
                    "text": "Both cat and dog",
                    "correct": true,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "Both calls use the same default set; add changes that object.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "Only dog",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "That would require a fresh set. A\u2019s default is created at definition time.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "An empty set",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "Both calls execute add on the shared set.",
                      "notChosenFeedback": ""
                    }
                  }
