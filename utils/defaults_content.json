                "answers": [
                  {
                    "text": "Raise AttributeError: a dictionary has no add method.",
                    "correct": true,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "{} creates a dict, not a set. An empty set is written set().",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "Fix the shared-default problem.",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "{} is still a mutable default, and its type is dict.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "Create a fresh empty set for every call.",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "{} creates one dictionary at definition time.",
