    {
      "library": "H5P.Column 1.18",
      "params": {
        "content": [
          {
            "content": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><code>def remember(word, words_to_include=None):<br />\u00a0\u00a0\u00a0\u00a0if words_to_include is None:<br />\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0words_to_include = set()<br />\u00a0\u00a0\u00a0\u00a0words_to_include.add(word)<br />\u00a0\u00a0\u00a0\u00a0return words_to_include</code></p>"
              },
              "subContentId": "1a32c1e7-3125-5e8d-862c-e6525d8447f5",
              "metadata": {
                "title": "Example to inspect",
                "license": "U",
                "authors": [],
                "changes": [],
                "contentType": "Text"
              }
            },
            "useSeparator": "disabled"
          },
          {
            "content": {
              "library": "H5P.MultiChoice 1.16",
              "params": {
                "media": {
                  "disableImageZooming": false
                },
                "answers": [
                  {
                    "text": "The is None branch creates a new set during each omitted call.",
                    "correct": true,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "Correct. None is the sentinel; set() runs inside each such call.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "Python copies every default argument for each call.",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "Python does not copy default arguments automatically.",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "None prevents the function from changing any set.",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "The function still calls add. It changes a fresh set, or the set supplied by the caller.",
                      "notChosenFeedback": ""
                    }
                  }
                ],
                "overallFeedback": [
                  {
                    "from": 0,
                    "to": 100
                  }
                ],
